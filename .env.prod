# 서버 정보
SERVER_ENV='prod'
SERVER_HOST='localhost'
SERVER_PORT=3000

# Swagger 정보
SWAGGER_TITLE='Express API Sample'
SWAGGER_VERSION='1.0.0'

# DB 정보
DB_HOST='localhost'
DB_SCHEME='portpolio_site'
DB_USER='portpolio_site'
DB_PASSWORD='1234'

# API 정보
API_PREFIX='/api'
AUTH_KEY='1234'

# Joplin 정보
JOPLIN_DIR='C:/path/to/joplin'
JOPLIN_HOST='http://192.168.1.190'

# JWT 정보
JWT_SECRET='thisisasamplesecretkeyforjwtgeneration'
JWT_ALGORITHM='HS256'

# Merge into the active .env.dev or .env.prod.
# Use llama.cpp server with E5 GGUF, --embedding --pooling mean, port 18082.
EMBEDDING_API_URL=http://127.0.0.1:18082/v1/embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_MS=60000
# E5 requires passage: for documents and query: for user queries.
EMBEDDING_DOCUMENT_PREFIX="passage: "
RAG_CHUNK_SIZE=300
RAG_CHUNK_OVERLAP=50

# Chat generation (separate from the E5 embedding server).
CHAT_API_URL=http://127.0.0.1:18081/v1/chat/completions
CHAT_MODEL=qwen3-0.6b
CHAT_API_KEY=
CHAT_TIMEOUT_MS=60000
RAG_MIN_SIMILARITY=0.78